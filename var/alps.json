{
  "$schema": "https://alps-io.github.io/schemas/alps.json",
  "alps": {
    "title": "Journal of Hypermedia Methods — Editorial System",
    "doc": {"value": "査読制ジャーナルの編集システム。投稿された manuscript が査読を経て article として issue に掲載されるまでの状態と遷移を記述する。"},
    "descriptor": [
      {"id": "manuscriptId", "title": "Manuscript ID", "doc": {"value": "編集システム内で投稿原稿を識別する番号。掲載後も変わらない。"}, "def": "https://schema.org/identifier"},
      {"id": "manuscriptTitle", "title": "Manuscript Title", "def": "https://schema.org/headline"},
      {"id": "abstract", "title": "Abstract", "def": "https://schema.org/abstract"},
      {"id": "keyword", "title": "Keyword", "def": "https://schema.org/keywords"},
      {"id": "submittedAt", "title": "Submission Date", "doc": {"value": "最初の版が投稿された日。改訂しても変わらない。"}, "def": "https://schema.org/dateCreated"},
      {"id": "manuscriptStatus", "title": "Manuscript Status", "doc": {"value": "審査の進行段階。under-review, revision-requested, accepted, rejected, withdrawn のいずれか。"}},

      {"id": "versionNumber", "title": "Version Number", "doc": {"value": "著者が提出した版の通し番号。改訂のたびに増える。"}, "def": "https://schema.org/version"},
      {"id": "versionNote", "title": "Version Note", "doc": {"value": "その版で著者が何を変えたかの自己申告。"}},

      {"id": "authorId", "title": "Author ID", "def": "https://schema.org/identifier"},
      {"id": "authorName", "title": "Author Name", "doc": {"value": "原稿を書いた人の氏名。"}, "def": "https://schema.org/author"},
      {"id": "affiliation", "title": "Affiliation", "def": "https://schema.org/affiliation"},
      {"id": "orcid", "title": "ORCID", "def": "https://schema.org/identifier"},

      {"id": "reviewerId", "title": "Reviewer ID", "def": "https://schema.org/identifier"},
      {"id": "reviewerName", "title": "Reviewer Name", "doc": {"value": "査読を担当した人の氏名。単一盲検のため著者には開示されないが、編集者には見える。"}},
      {"id": "expertise", "title": "Field of Expertise", "doc": {"value": "査読者の専門分野。担当割り当ての根拠になる。"}, "def": "https://schema.org/knowsAbout"},
      {"id": "availability", "title": "Availability", "doc": {"value": "査読を新たに引き受けられるかどうか。"}},

      {"id": "reviewId", "title": "Review ID", "def": "https://schema.org/identifier"},
      {"id": "recommendation", "title": "Reviewer Recommendation", "doc": {"value": "査読者が編集者に伝える意見。accept, minor-revision, major-revision, reject のいずれか。これは助言であって決定ではない。"}},
      {"id": "score", "title": "Review Score", "doc": {"value": "査読者による 1〜5 の総合評点。"}, "def": "https://schema.org/ratingValue"},
      {"id": "publicComment", "title": "Comment to Authors", "doc": {"value": "著者に開示される査読コメント。"}},
      {"id": "confidentialComment", "title": "Confidential Comment to Editor", "doc": {"value": "編集者だけが読むコメント。著者には開示されない。"}},
      {"id": "reviewSubmittedAt", "title": "Review Submission Date"},

      {"id": "decisionId", "title": "Decision ID", "def": "https://schema.org/identifier"},
      {"id": "decisionOutcome", "title": "Editorial Decision", "doc": {"value": "編集者が下す最終判断。accept, revise, reject のいずれか。査読者の recommendation と一致しないことがある。"}},
      {"id": "decisionRationale", "title": "Decision Rationale", "doc": {"value": "編集者が査読意見をどう weigh したかの説明。"}},
      {"id": "decidedAt", "title": "Decision Date"},

      {"id": "revisionId", "title": "Revision Request ID", "def": "https://schema.org/identifier"},
      {"id": "revisionDeadline", "title": "Revision Deadline"},
      {"id": "requiredChange", "title": "Required Change", "doc": {"value": "再投稿の条件として編集者が明示した修正項目。"}},

      {"id": "issueId", "title": "Issue ID", "def": "https://schema.org/identifier"},
      {"id": "volumeNumber", "title": "Volume Number", "def": "https://schema.org/volumeNumber"},
      {"id": "issueNumber", "title": "Issue Number", "def": "https://schema.org/issueNumber"},
      {"id": "publishedAt", "title": "Publication Date", "def": "https://schema.org/datePublished"},

      {"id": "articleId", "title": "Article ID", "doc": {"value": "掲載後の論文を識別する番号。manuscriptId とは別に振られる。"}, "def": "https://schema.org/identifier"},
      {"id": "doi", "title": "DOI", "doc": {"value": "掲載された論文に付与される永続識別子。投稿中の原稿には存在しない。"}, "def": "https://schema.org/identifier"},
      {"id": "pageRange", "title": "Page Range", "def": "https://schema.org/pagination"},

      {"id": "Home", "title": "Editorial Home", "doc": {"value": "編集システムの入口。審査中の原稿、刊行済みの号、査読者名簿のそれぞれに分岐する。"}, "tag": "navigation", "descriptor": [
        {"href": "#goManuscriptList"},
        {"href": "#goIssueList"},
        {"href": "#goReviewerPool"}
      ]},

      {"id": "ManuscriptList", "title": "Manuscripts Under Consideration", "doc": {"value": "まだ掲載されていない投稿原稿の一覧。掲載済みの論文はここには現れない。"}, "tag": "manuscript flow-review", "descriptor": [
        {"href": "#manuscriptId"},
        {"href": "#manuscriptTitle"},
        {"href": "#manuscriptStatus"},
        {"href": "#goManuscriptDetail"},
        {"href": "#goHome"}
      ]},

      {"id": "ManuscriptDetail", "title": "Manuscript Detail", "doc": {"value": "投稿原稿 1 件の審査状況。査読、改訂履歴、編集判断のそれぞれに分岐する。"}, "tag": "manuscript flow-review", "descriptor": [
        {"href": "#manuscriptId"},
        {"href": "#manuscriptTitle"},
        {"href": "#abstract"},
        {"href": "#manuscriptStatus"},
        {"href": "#submittedAt"},
        {"href": "#goReviewList"},
        {"href": "#goVersionHistory"},
        {"href": "#goAuthorProfile"},
        {"href": "#goEditorDecision"},
        {"href": "#goManuscriptList"},
        {"href": "#doWithdrawManuscript"}
      ]},

      {"id": "VersionHistory", "title": "Version History", "doc": {"value": "著者が提出した版の一覧。編集者が要求した修正項目ではなく、著者が実際に出したものの記録。"}, "tag": "manuscript", "descriptor": [
        {"href": "#versionNumber"},
        {"href": "#versionNote"},
        {"href": "#submittedAt"},
        {"href": "#goManuscriptDetail"}
      ]},

      {"id": "ReviewList", "title": "Submitted Reviews", "doc": {"value": "この原稿について提出済みの査読の一覧。査読者ごとに 1 件。"}, "tag": "review flow-review", "descriptor": [
        {"href": "#reviewId"},
        {"href": "#recommendation"},
        {"href": "#score"},
        {"href": "#goReviewDetail"},
        {"href": "#goManuscriptDetail"}
      ]},

      {"id": "ReviewDetail", "title": "Review Detail", "doc": {"value": "査読 1 件の全文。誰が書いたかを辿れる。"}, "tag": "review flow-review", "descriptor": [
        {"href": "#reviewId"},
        {"href": "#recommendation"},
        {"href": "#score"},
        {"href": "#publicComment"},
        {"href": "#confidentialComment"},
        {"href": "#reviewSubmittedAt"},
        {"href": "#goReviewerProfile"},
        {"href": "#goReviewList"}
      ]},

      {"id": "ReviewerPool", "title": "Reviewer Roster", "doc": {"value": "査読を依頼できる人の名簿。特定の原稿とは結び付いていない。誰が何を査読したかはここでは分からない。"}, "tag": "reviewer", "descriptor": [
        {"href": "#reviewerId"},
        {"href": "#reviewerName"},
        {"href": "#expertise"},
        {"href": "#availability"},
        {"href": "#goReviewerProfile"},
        {"href": "#goHome"}
      ]},

      {"id": "ReviewerProfile", "title": "Reviewer Profile", "doc": {"value": "査読者 1 人の情報。"}, "tag": "reviewer", "descriptor": [
        {"href": "#reviewerId"},
        {"href": "#reviewerName"},
        {"href": "#expertise"},
        {"href": "#affiliation"},
        {"href": "#goReviewerPool"}
      ]},

      {"id": "EditorDecision", "title": "Editorial Decision", "doc": {"value": "編集者がこの原稿について下した判断。査読者の recommendation を集約した結果であり、一致するとは限らない。"}, "tag": "decision flow-review", "descriptor": [
        {"href": "#decisionId"},
        {"href": "#decisionOutcome"},
        {"href": "#decisionRationale"},
        {"href": "#decidedAt"},
        {"href": "#goManuscriptDetail"},
        {"href": "#goRevisionRequest"}
      ]},

      {"id": "RevisionRequest", "title": "Revision Request", "tag": "decision", "descriptor": [
        {"href": "#revisionId"},
        {"href": "#requiredChange"},
        {"href": "#revisionDeadline"},
        {"href": "#goEditorDecision"}
      ]},

      {"id": "IssueList", "title": "Published Issues", "doc": {"value": "刊行済みの号の一覧。審査中の原稿は含まれない。"}, "tag": "issue flow-publication", "descriptor": [
        {"href": "#issueId"},
        {"href": "#volumeNumber"},
        {"href": "#issueNumber"},
        {"href": "#publishedAt"},
        {"href": "#goIssueDetail"},
        {"href": "#goHome"}
      ]},

      {"id": "IssueDetail", "title": "Issue Detail", "doc": {"value": "1 つの号に掲載された論文の目次。"}, "tag": "issue flow-publication", "descriptor": [
        {"href": "#issueId"},
        {"href": "#volumeNumber"},
        {"href": "#issueNumber"},
        {"href": "#publishedAt"},
        {"href": "#goIssueList"}
      ]},

      {"id": "ArticleDetail", "title": "Published Article", "doc": {"value": "掲載された論文。元になった投稿原稿に遡れる。"}, "tag": "issue flow-publication", "descriptor": [
        {"href": "#articleId"},
        {"href": "#doi"},
        {"href": "#manuscriptTitle"},
        {"href": "#authorName"},
        {"href": "#pageRange"},
        {"href": "#goIssueDetail"},
        {"href": "#goAuthorProfile"}
      ]},

      {"id": "AuthorProfile", "title": "Author Profile", "doc": {"value": "著者 1 人の情報。"}, "tag": "author", "descriptor": [
        {"href": "#authorId"},
        {"href": "#authorName"},
        {"href": "#affiliation"},
        {"href": "#orcid"},
        {"href": "#goHome"}
      ]},

      {"id": "CorrigendumList", "title": "Corrigenda", "doc": {"value": "掲載後に発行された訂正記事の一覧。"}, "tag": "issue", "descriptor": [
        {"href": "#articleId"},
        {"href": "#publishedAt"},
        {"href": "#goIssueList"}
      ]},

      {"id": "goHome", "type": "safe", "rt": "#Home", "title": "Go to Editorial Home", "doc": {"value": "入口に戻る。"}, "tag": "navigation"},

      {"id": "goManuscriptList", "type": "safe", "rt": "#ManuscriptList", "title": "View Manuscripts Under Consideration", "doc": {"value": "まだ掲載に至っていない投稿原稿の一覧を開く。"}, "tag": "manuscript flow-review"},

      {"id": "goManuscriptDetail", "type": "safe", "rt": "#ManuscriptDetail", "title": "View Manuscript Detail", "doc": {"value": "投稿原稿 1 件の審査状況を開く。掲載済みの論文からその元原稿へ遡るときにも使う。"}, "tag": "manuscript flow-review", "descriptor": [
        {"href": "#manuscriptId"}
      ]},

      {"id": "goVersionHistory", "type": "safe", "rt": "#VersionHistory", "title": "View Version History", "doc": {"value": "関連する記録を開く。"}, "tag": "manuscript", "descriptor": [
        {"href": "#manuscriptId"}
      ]},

      {"id": "goReviewList", "type": "safe", "rt": "#ReviewList", "title": "View Submitted Reviews", "doc": {"value": "この原稿について提出された査読の一覧を開く。個々の査読者の意見はここから辿る。"}, "tag": "review flow-review", "descriptor": [
        {"href": "#manuscriptId"}
      ]},

      {"id": "goReviewDetail", "type": "safe", "rt": "#ReviewDetail", "title": "View Review Detail", "doc": {"value": "査読 1 件の全文を開く。書いた査読者を特定できるのはこの状態から。"}, "tag": "review flow-review", "descriptor": [
        {"href": "#reviewId"}
      ]},

      {"id": "goReviewerPool", "type": "safe", "rt": "#ReviewerPool", "title": "View Reviewer Roster", "doc": {"value": "査読を依頼できる人の名簿を開く。特定の原稿の査読者を探す用途には使えない。"}, "tag": "reviewer"},

      {"id": "goReviewerProfile", "type": "safe", "rt": "#ReviewerProfile", "title": "View Reviewer Profile", "doc": {"value": "査読者 1 人の情報を開く。"}, "tag": "reviewer", "descriptor": [
        {"href": "#reviewerId"}
      ]},

      {"id": "goEditorDecision", "type": "safe", "rt": "#EditorDecision", "title": "View Editorial Decision", "doc": {"value": "編集者が下した判断を開く。個々の査読者の意見ではなく、集約後の結論。"}, "tag": "decision flow-review", "descriptor": [
        {"href": "#manuscriptId"}
      ]},

      {"id": "goRevisionRequest", "type": "safe", "rt": "#RevisionRequest", "title": "View Revision Request", "tag": "decision", "descriptor": [
        {"href": "#decisionId"}
      ]},

      {"id": "goIssueList", "type": "safe", "rt": "#IssueList", "title": "View Published Issues", "doc": {"value": "刊行済みの号の一覧を開く。掲載された論文はここから辿る。"}, "tag": "issue flow-publication"},

      {"id": "goIssueDetail", "type": "safe", "rt": "#IssueDetail", "title": "View Issue Detail", "doc": {"value": "1 つの号の目次を開く。"}, "tag": "issue flow-publication", "descriptor": [
        {"href": "#issueId"}
      ]},

      {"id": "goAuthorProfile", "type": "safe", "rt": "#AuthorProfile", "title": "View Author Profile", "doc": {"value": "著者 1 人の情報を開く。"}, "tag": "author", "descriptor": [
        {"href": "#authorId"}
      ]},

      {"id": "goCorrigendumList", "type": "safe", "rt": "#CorrigendumList", "title": "View Corrigenda", "doc": {"value": "掲載後の訂正記事の一覧を開く。"}, "tag": "issue"},

      {"id": "doSubmitManuscript", "type": "unsafe", "rt": "#ManuscriptDetail", "title": "Submit a Manuscript", "doc": {"value": "新しい原稿を投稿する。"}, "tag": "manuscript flow-review", "descriptor": [
        {"href": "#manuscriptTitle"},
        {"href": "#abstract"},
        {"href": "#authorId"}
      ]},

      {"id": "doAssignReviewer", "type": "unsafe", "rt": "#ManuscriptDetail", "title": "Assign a Reviewer", "doc": {"value": "原稿に査読者を割り当てる。"}, "tag": "reviewer flow-review", "descriptor": [
        {"href": "#manuscriptId"},
        {"href": "#reviewerId"}
      ]},

      {"id": "doSubmitReview", "type": "unsafe", "rt": "#ReviewList", "title": "Submit a Review", "doc": {"value": "査読結果を提出する。"}, "tag": "review flow-review", "descriptor": [
        {"href": "#manuscriptId"},
        {"href": "#recommendation"},
        {"href": "#score"},
        {"href": "#publicComment"}
      ]},

      {"id": "doRecordDecision", "type": "unsafe", "rt": "#EditorDecision", "title": "Record an Editorial Decision", "doc": {"value": "編集判断を記録する。"}, "tag": "decision flow-review", "descriptor": [
        {"href": "#manuscriptId"},
        {"href": "#decisionOutcome"},
        {"href": "#decisionRationale"}
      ]},

      {"id": "doWithdrawManuscript", "type": "idempotent", "rt": "#ManuscriptList", "title": "Withdraw a Manuscript", "doc": {"value": "投稿を取り下げる。審査は打ち切られる。"}, "tag": "manuscript", "descriptor": [
        {"href": "#manuscriptId"}
      ]}
    ]
  }
}
